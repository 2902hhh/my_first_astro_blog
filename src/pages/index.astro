---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import AvatarTicket from '../components/AvatarTicket.astro';
import { getRecentPosts } from '../lib/posts';
const name = '丁焕';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as import('../lib/posts').Post[];
const recentPosts = getRecentPosts(allPosts);
---
<BaseLayout pageTitle={name} pageDescription="丁焕的个人博客，记录技术学习、项目实践和生活片段。" appearance="home">
  <div class="home-layout">
    <div class="home-profile">
      <section class="hero" aria-labelledby="hero-title">
        <h1 class="sr-only" id="hero-title">{name}</h1>
        <AvatarTicket name={name} />
      </section>
      <section class="blog-grid" aria-label="博客分类">
        <a href="/tech" class="category-link category-tech">
          <div class="category-top"><span class="eyebrow">01 / TECH</span><span class="category-arrow" aria-hidden="true">↗</span></div>
          <h2>技术相关</h2>
          <p>学习笔记和项目记录。</p>
        </a>
        <a href="/life" class="category-link category-life">
          <div class="category-top"><span class="eyebrow">02 / LIFE</span><span class="category-arrow" aria-hidden="true">↗</span></div>
          <h2>代码之外</h2>
          <p>日常感受、照片和一些思考。</p>
        </a>
      </section>
    </div>
    <section class="home-recent" aria-labelledby="recent-title">
      <header class="section-heading">
        <div><span class="eyebrow">LATEST NOTES</span><h2 id="recent-title">最近更新</h2></div>
      </header>
      <PostList posts={recentPosts} emptyText="新的记录正在路上。" showPinned={false} headingLevel="h3" showLatestDate />
    </section>
  </div>
</BaseLayout>

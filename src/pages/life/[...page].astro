---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { getCategoryPaths, type Post } from '../../lib/posts';

export function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../posts/*.md', { eager: true })) as Post[];
  return getCategoryPaths(posts, 'life');
}
const { posts, currentPage, totalPages } = Astro.props;
---
<BaseLayout appearance="life" pageTitle="代码之外" pageDescription="日常感受、照片和一些不太像项目总结的记录。">
  <div class="page-content">
    <div class="page-header">
      <span class="eyebrow">LIFE / 生活</span>
      <h1>代码之外</h1>
      <p>一些日常观察、想法和阶段性的心情记录。</p>
    </div>
    <PostList posts={posts} category="life" emptyText="这里还没有代码之外的文章。" />
    <Pagination category="life" currentPage={currentPage} totalPages={totalPages} />
  </div>
</BaseLayout>

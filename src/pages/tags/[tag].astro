---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getTagPaths, type Post } from '../../lib/posts';
export function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../posts/*.md', { eager: true })) as Post[];
  return getTagPaths(posts);
}
const { tag, posts } = Astro.props;
---
<BaseLayout appearance="tags" pageTitle={`标签：${tag}`} pageDescription={`所有带有 ${tag} 标签的文章。`}>
  <div class="page-content">
    <div class="page-header">
      <span class="eyebrow">TOPICS / 标签</span>
      <h1>#{tag}</h1>
      <p>共 {posts.length} 篇文章</p>
    </div>
    <div class="tag-return"><a class="back-link" href="/tech">技术相关 ↗</a><a class="back-link" href="/life">代码之外 ↗</a></div>
    <PostList posts={posts} showPinned={false} emptyText="没有找到这个标签下的文章。" />
  </div>
</BaseLayout>

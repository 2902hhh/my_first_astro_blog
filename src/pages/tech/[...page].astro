---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { getCategoryPaths, type Post } from '../../lib/posts';

export function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../posts/*.md', { eager: true })) as Post[];
  return getCategoryPaths(posts, 'tech');
}
const { posts, currentPage, totalPages } = Astro.props;
---
<BaseLayout appearance="tech" pageTitle="技术相关" pageDescription="嵌入式、C/C++、Linux、ROS2 相关的学习笔记和项目记录。">
  <div class="page-content">
    <div class="page-header">
      <span class="eyebrow">TECH / 技术</span>
      <h1>技术相关</h1>
      <p>学习笔记、项目记录，以及一些踩坑后的整理。</p>
    </div>
    <PostList posts={posts} category="tech" emptyText="这里还没有技术文章。" />
    <Pagination category="tech" currentPage={currentPage} totalPages={totalPages} />
  </div>
</BaseLayout>

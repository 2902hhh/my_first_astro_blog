---
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const headings = Astro.props.headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
{headings.length >= 3 && (
  <aside class="article-toc" aria-label="文章目录">
    <details open>
      <summary>文章目录 <span class="toc-chevron" aria-hidden="true">⌄</span></summary>
      <nav aria-label="章节导航">
        <ol>
          {headings.map(heading => (
            <li class:list={{ 'toc-subheading': heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}

---
// Lightweight blog post preview for listing pages.

import TagPill from './TagPill.astro';

interface Props {
  title: string;
  url: string;
  date: string;
  description?: string;
  headingLevel?: 'h2' | 'h3';
  updated?: boolean;
  tags?: string[];
  category?: 'tech' | 'life';
  pinned?: boolean;
}

const {
  title,
  url,
  date,
  description,
  headingLevel = 'h2',
  updated = false,
  tags = [],
  category = 'tech',
  pinned = false,
} = Astro.props;

const categoryLabel = category === 'tech' ? '技术相关' : '代码之外';
const Heading = headingLevel;
---

<a href={url} class="post-card-link">
  <article class="post-card">
    <div class="post-card-meta">
      {pinned && <span class="glass-pill pinned">置顶</span>}
      <span class={`glass-pill ${category}`}>{categoryLabel}</span>
      <time datetime={date}>{date}{updated && ' · 更新'}</time>
    </div>

    <Heading class="post-card-title">{title}<span class="post-arrow" aria-hidden="true">↗</span></Heading>
    {description && <p class="post-card-desc">{description}</p>}

    {tags.length > 0 && <div class="post-card-footer">
      {tags.slice(0, 3).map((tag: string) => (
        <TagPill tag={tag} />
      ))}
    </div>}
  </article>
</a>

---
import PostCard from './PostCard.astro';
import { formatDate, type Post, type Category } from '../lib/posts';
interface Props { posts: Post[]; emptyText: string; category?: Category; showPinned?: boolean; headingLevel?: 'h2' | 'h3'; showLatestDate?: boolean; }
const { posts, emptyText, category, showPinned = true, headingLevel = 'h2', showLatestDate = false } = Astro.props;
---
{posts.length > 0 ? (
  <ul class="post-list">
    {posts.map(post => (
      <li class="post-list-item">
        <PostCard
          title={post.frontmatter.title}
          url={post.url}
          date={formatDate(showLatestDate ? post.frontmatter.updatedDate || post.frontmatter.pubDate : post.frontmatter.pubDate)}
          updated={showLatestDate && !!post.frontmatter.updatedDate}
          headingLevel={headingLevel}
          description={post.frontmatter.description}
          tags={post.frontmatter.tags || []}
          category={category || post.frontmatter.category || 'tech'}
          pinned={showPinned && post.frontmatter.pinned}
        />
      </li>
    ))}
  </ul>
) : (
  <div class="empty-state"><p class="empty-state-text">{emptyText}</p></div>
)}

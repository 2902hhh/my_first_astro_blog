---
interface Props { name: string }

const { name } = Astro.props;
const quote = "But thy eternal summer shall not fade,\nNor lose possession of that fair thou ow'st";
---

<button class="avatar-ticket" type="button" aria-label="翻转头像票卡" aria-pressed="false" title="翻转头像票卡" data-avatar-ticket disabled>
  <span class="ticket-rotor" data-ticket-rotor aria-hidden="true">
    <span class="ticket-face ticket-front">
      <img class="ticket-portrait" data-ticket-portrait src="/images/head.jpg" alt="" width="1080" height="1080" fetchpriority="high" draggable="false" />
      <span class="ticket-glare"></span>
      <span class="ticket-name" data-ticket-name>{name}</span>
    </span>
    <span class="ticket-face ticket-back">
      <span class="ticket-quote" data-ticket-quote lang="en">{quote}</span>
    </span>
  </span>
</button>
<span class="sr-only" data-ticket-status role="status" lang="en"></span>

<style>
  .avatar-ticket {
    /* DesignBookmark Parallax Ticket motion settings. */
    --ticket-tilt: 14;
    --ticket-depth: 12;
    --ticket-flip: 170 15;
    --ticket-follow: 220 18;
    --ticket-glare: 300 26;
    --ticket-lift: 300 18;
    display: block;
    position: relative;
    width: min(100%, 232px);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: var(--glass-radius);
    background: none;
    color: inherit;
    perspective: 900px;
    touch-action: manipulation;
    user-select: none;
  }
  .avatar-ticket:disabled { cursor: default; }
  .avatar-ticket:focus-visible { border-radius: var(--glass-radius); }
  .ticket-rotor {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .ticket-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--color-separator);
    border-radius: var(--glass-radius);
    background: var(--color-surface);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 16px 28px -21px color-mix(in srgb, var(--color-text) 32%, transparent);
  }
  .ticket-portrait {
    position: absolute;
    inset: -6px;
    width: calc(100% + 12px);
    height: calc(100% + 12px);
    max-width: none;
    object-fit: cover;
  }
  .ticket-glare {
    position: absolute;
    inset: 0;
    opacity: var(--ticket-shine, 0);
    background: radial-gradient(200px circle at var(--ticket-x, 50%) var(--ticket-y, 30%), color-mix(in srgb, var(--aurora-blue) 56%, transparent), transparent 70%);
    mix-blend-mode: screen;
  }
  .ticket-front::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgb(10 12 22 / .72));
  }
  .ticket-name {
    position: absolute;
    z-index: 1;
    left: 20px;
    bottom: 18px;
    color: #fff;
    font: 650 clamp(34px, 4vw, 46px)/1.15 var(--font-body);
    letter-spacing: .06em;
  }
  .ticket-back {
    display: grid;
    align-content: center;
    padding: 18px 17px;
    transform: rotateY(180deg);
    background: radial-gradient(ellipse at 20% 0%, color-mix(in srgb, var(--aurora-violet) 38%, transparent), transparent 72%), var(--color-surface);
  }
  .ticket-quote {
    color: var(--color-text);
    font: 650 var(--text-sm)/1.72 var(--font-code);
    text-align: left;
    white-space: pre-line;
  }
  .ticket-quote :global([data-ticket-word]) { white-space: nowrap; }
  .ticket-quote :global([data-pending]) { color: var(--color-text-tertiary); }
  .ticket-quote[data-decoding] :global([data-ticket-word]:last-child)::after {
    content: '';
    position: absolute;
    width: .45em;
    height: 1em;
    margin: .35em 0 0 .13em;
    border-radius: 2px;
    background: var(--color-accent);
  }
  @media (max-width: 600px) {
    .avatar-ticket { width: min(100%, 210px); }
  }
</style>

<script>
  import { mountAvatarTicket } from '../scripts/avatar-ticket';
  document.querySelectorAll<HTMLButtonElement>('[data-avatar-ticket]').forEach(mountAvatarTicket);
</script>

---
import type { Category } from '../lib/posts';
interface Props { category: Category; currentPage: number; totalPages: number; }
const { category, currentPage, totalPages } = Astro.props;
---
{totalPages > 1 && (
  <nav class="pagination" aria-label="分页导航">
    {currentPage > 1 ? (
      <a href={currentPage === 2 ? `/${category}` : `/${category}/${currentPage - 1}`} class="glass-button" rel="prev">上一页</a>
    ) : <span class="glass-button" aria-disabled="true">上一页</span>}
    <span class="pagination-info">{currentPage} / {totalPages}</span>
    {currentPage < totalPages ? (
      <a href={`/${category}/${currentPage + 1}`} class="glass-button" rel="next">下一页</a>
    ) : <span class="glass-button" aria-disabled="true">下一页</span>}
  </nav>
)}

---
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/TagPill.astro';

interface Props {
  frontmatter: {
    title: string;
    pubDate: Date;
    author: string;
    description?: string;
    image?: {
      url: string;
      alt: string;
    };
    tags?: string[];
    category?: 'tech' | 'life';
    layout?: string;
  };
}

const { frontmatter } = Astro.props;

const dateStr = frontmatter.pubDate instanceof Date
  ? frontmatter.pubDate.toISOString().slice(0, 10)
  : String(frontmatter.pubDate).slice(0, 10);

const category = frontmatter.category || 'tech';
const categoryLabel = category === 'tech' ? '技术博客' : '生活随笔';
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description || `${frontmatter.author} 的一篇文章`}
>
  <article class="page-content">
    <header class="page-header article-header">
      <div style="margin-bottom: var(--space-md);">
        <a href={`/${category}`} class={`glass-pill ${category}`}>
          {categoryLabel}
        </a>
      </div>

      <h1>{frontmatter.title}</h1>

      <div class="article-meta">
        <time datetime={dateStr}>{dateStr}</time>
        <span aria-hidden="true">/</span>
        <span>{frontmatter.author}</span>
      </div>
    </header>

    {
      frontmatter.image?.url && (
        <img
          src={frontmatter.image.url}
          alt={frontmatter.image.alt || ''}
          class="article-cover"
          loading="lazy"
        />
      )
    }

    <div class="article-body">
      <slot />
    </div>

    {
      frontmatter.tags && frontmatter.tags.length > 0 && (
        <footer class="article-tags">
          <span>标签</span>
          {frontmatter.tags.map((tag: string) => (
            <TagPill tag={tag} href={`/tags/${tag}`} />
          ))}
        </footer>
      )
    }
  </article>
</BaseLayout>

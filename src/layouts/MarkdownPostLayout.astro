---
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/TagPill.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostNavigation from '../components/PostNavigation.astro';
import ImageViewer from '../components/ImageViewer.astro';
import { formatDate, getAdjacentPosts, type PostFrontmatter, type Post } from '../lib/posts';
import type { MarkdownLayoutProps } from 'astro';
import 'katex/dist/katex.min.css';

type Props = MarkdownLayoutProps<PostFrontmatter>;

const { frontmatter, headings = [], url } = Astro.props;
const dateStr = formatDate(frontmatter.pubDate);
const updatedDate = frontmatter.updatedDate ? formatDate(frontmatter.updatedDate) : undefined;
const author = frontmatter.author || '丁焕';
const allPosts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true })) as Post[];
const { previous, next } = getAdjacentPosts(allPosts, url || Astro.url.pathname);

const category = frontmatter.category || 'tech';
const categoryLabel = category === 'tech' ? '技术相关' : '代码之外';
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description || `${author} 的一篇文章`}
  activeCategory={category}
  appearance="article"
>
  <div class="article-layout">
  <article class="page-content article-content">
    <header class="page-header article-header">
      <div class="article-back">
        <a href={`/${category}`} class="back-link">
          <span aria-hidden="true">←</span> {categoryLabel}
        </a>
      </div>

      <h1>{frontmatter.title}</h1>

      <div class="article-meta">
        <time datetime={dateStr}>{dateStr}</time>
        <span aria-hidden="true">/</span>
        <span>{author}</span>
        {updatedDate && updatedDate !== dateStr && <span class="article-updated">最后更新 <time datetime={updatedDate}>{updatedDate}</time></span>}
      </div>
    </header>

    <TableOfContents headings={headings} />

    {
      frontmatter.image?.url && (
        <img
          src={frontmatter.image.url}
          alt={frontmatter.image.alt || ''}
          class="article-cover"
          loading="lazy"
        />
      )
    }

    <div class="article-body">
      <slot />
    </div>

    {
      frontmatter.tags && frontmatter.tags.length > 0 && (
        <footer class="article-tags">
          <span>标签</span>
          {frontmatter.tags.map((tag: string) => (
            <TagPill tag={tag} href={`/tags/${tag}`} />
          ))}
        </footer>
      )
    }
    <PostNavigation previous={previous} next={next} />
  </article>
  </div>
  <ImageViewer />
  <p class="reader-status sr-only" role="status" aria-live="polite"></p>
  <script>
    import '../scripts/article-toc';
    import '../scripts/code-copy';
    import '../scripts/image-viewer';
  </script>
</BaseLayout>
